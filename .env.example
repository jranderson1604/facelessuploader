# Reddit API credentials (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=faceless-uploader/1.0

# YouTube API (OAuth2 - run `faceless auth youtube` to set up)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# TikTok session cookie (log in to TikTok in browser, copy sessionid cookie)
TIKTOK_SESSION_ID=your_session_id

# Instagram credentials
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# TTS engine: "edge" (best quality, free), "gtts" (Google), "pyttsx3" (offline)
TTS_ENGINE=edge

# Edge TTS voice (run `edge-tts --list-voices` for options)
TTS_VOICE=en-US-ChristopherNeural

# Video settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
BACKGROUND_VIDEO_DIR=./backgrounds
OUTPUT_DIR=./output
FONT_SIZE=60
FONT_COLOR=white
SUBTITLE_STYLE=word_highlight

# Scheduler settings
UPLOADS_PER_DAY=10
SCHEDULE_START_HOUR=8
SCHEDULE_END_HOUR=22

# Web dashboard
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_SECRET_KEY=change-this-to-a-random-string
